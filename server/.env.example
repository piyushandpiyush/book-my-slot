PORT=5000
# Leave MONGODB_URI empty in development to use an in-memory MongoDB automatically
MONGODB_URI=
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
CLIENT_URL=http://localhost:5173
# Leave Razorpay keys empty to run payments in MOCK mode (dev only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Google Sign-In (OAuth Web client ID from Google Cloud Console; public value)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The admin signs in with Google using this email
ADMIN_EMAIL=admin@bookmyslot.com
